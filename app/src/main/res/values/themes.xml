<resources>
    <!-- Tema AppCompat murni (tanpa library material): APK lebih kecil.
         Tema TERANG biru-putih menyeluruh gaya Vaultwarden Host
         (keputusan owner 2026-11-08): induk Theme.AppCompat.NoActionBar
         + MODE_NIGHT_NO dipaksa di App agar dialog, menu titik tiga,
         dan semua layar ikut terang. -->
    <style name="Theme.HttpDownloadManager" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <!-- Dialog peringatan memakai overlay sendiri (lihat gaya di
             bawah): tombolnya biru primer, bukan oranye colorAccent
             tema induk yang khusus fokus D-pad. -->
        <item name="alertDialogTheme">@style/Theme.HttpDownloadManager.AlertDialog</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Fokus D-pad wajib kelihatan (Android 6 tidak menggambar
             highlight fokus otomatis). -->
        <item name="android:colorControlHighlight">@color/accent</item>
        <item name="colorControlHighlight">@color/accent</item>
    </style>

    <!-- Overlay tema AlertDialog: colorAccent biru primer agar tombol
         dialog (OK/Cancel/Delete/dsb.) tampil biru #1565C0 seperti
         dialog kustom, bukan oranye aksen fokus D-pad. Overlay hanya
         berlaku di dalam dialog; colorAccent tema induk tidak berubah.
         CAKUPAN RESMI overlay ini (didokumentasikan issue #1504):
         colorAccent di dalam dialog tidak hanya mewarnai tombol —
         widget AppCompat di dalam dialog yang membaca colorAccent
         ikut biru primer, dan itu DISENGAJA serta konsisten tema:
         (1) tombol dialog positif/negatif/netral; (2) kursor dan
         gagang seleksi EditText di dalam dialog (mis. kolom Rename
         dan Add Download — sheet Add Download adalah Dialog polos,
         jadi ia memakai overlay ini lewat ContextThemeWrapper saat
         dibuat dan di-inflate, bukan lewat alertDialogTheme);
         (3) ProgressBar indeterminate di dalam dialog (saat ini tak
         ada ProgressBar di dialog mana pun; cakupan ini berlaku bila
         suatu saat ditambahkan). Jangan mempersempit overlay ini
         hanya demi tombol:
         widget dialog yang kembali oranye justru inkonsistensi.
         Di luar dialog, colorAccent induk (@color/accent oranye)
         tetap berlaku penuh untuk fokus D-pad dan widget layar. -->
    <style name="Theme.HttpDownloadManager.AlertDialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/primary</item>
    </style>

    <!-- Toolbar biru Vaultwarden dengan teks putih. -->
    <style name="Toolbar.Theme.HttpDownloadManager" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <!-- Warna ikon tipis (titik tiga overflow) jadi putih di toolbar primary. -->
        <item name="colorControlNormal">@color/white</item>
        <item name="android:colorControlNormal">@color/white</item>
    </style>

    <!-- Judul topbar ramping layar utama: satu baris 19sp tebal. -->
    <style name="HomeToolbarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Tombol terisi (primary). -->
    <style name="AppButton" parent="Widget.AppCompat.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_btn_filled</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/btn_text_filled</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TvOutlinedButton" parent="Widget.AppCompat.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_btn_tv</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/btn_text_outlined</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Input dialog Add Download. -->
    <style name="AppInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_tv</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Splash klasik tanpa library core-splashscreen: windowBackground
         langsung dari tema (kompat Android 6+, minSdk 23). -->
    <style name="Theme.HttpDownloadManager.Splash" parent="Theme.HttpDownloadManager">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>
</resources>
