<resources>
    <!-- Tema AppCompat murni (tanpa library material): APK lebih kecil.
         Satu tema terang saja — values-night dihapus (lihat CHANGELOG). -->
    <style name="Theme.HttpDownloadManager" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:colorBackground">@color/window_bg</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Fokus D-pad wajib kelihatan (Android 6 tidak menggambar
             highlight fokus otomatis). -->
        <item name="android:colorControlHighlight">@color/accent</item>
        <item name="colorControlHighlight">@color/accent</item>
    </style>

    <!-- Toolbar berwarna primary dengan teks putih. -->
    <style name="Toolbar.Theme.HttpDownloadManager" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="android:minHeight">?attr/actionBarSize</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <!-- Warna ikon tipis (titik tiga overflow) jadi putih di toolbar primary. -->
        <item name="colorControlNormal">@color/white</item>
        <item name="android:colorControlNormal">@color/white</item>
    </style>

    <!-- Tombol terisi (primary). -->
    <style name="AppButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_filled</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TvOutlinedButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_btn_tv</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Chip saran platform di empty state (gaya pill). -->
    <style name="SuggestionChip" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_suggestion_chip</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Input dialog Add Download. -->
    <style name="AppInput" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_tv</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Splash klasik tanpa library core-splashscreen: windowBackground
         langsung dari tema (kompat Android 5+). -->
    <style name="Theme.HttpDownloadManager.Splash" parent="Theme.HttpDownloadManager">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>
</resources>
