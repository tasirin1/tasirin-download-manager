<?xml version="1.0" encoding="utf-8"?>
<!-- Network security: HTTPS wajib untuk semua outbound (GitHub API, update),
     tapi download manager perlu HTTP untuk URL unduhan user.
     Cleartext diizinkan secara umum (download manager memang butuh HTTP),
     tapi trust anchor TLS kustom tetap ditambah untuk server remote. -->
<network-security-config>
    <!-- Cleartext global = fungsi inti (URL unduhan milik pengguna bisa HTTP).
         Domain pihak-pertama dikunci HTTPS di bawah; tools:ignore hanya untuk
         peringatan InsecureBaseConfiguration agar lint tetap hijau. -->
    <base-config
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="InsecureBaseConfiguration"
        cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/digicert_global_root_g2" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/sectigo_public_server_auth_root_r46" />
        </trust-anchors>
    </base-config>
    <!-- Lalu lintas aplikasi sendiri (update, dsb.) wajib HTTPS + system trust. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">githubassets.com</domain>
    </domain-config>
</network-security-config>
