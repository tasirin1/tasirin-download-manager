<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp">

    <EditText
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:minHeight="48dp"
        android:id="@+id/input_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/url_hint_multi"
        android:inputType="textUri|textMultiLine"
        android:autofillHints="url"
        android:minLines="2"
        android:maxLines="4" />

    <TextView
        android:id="@+id/text_storage_remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/text_file_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/recent_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/recent_urls"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:visibility="gone" />

    <EditText
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:minHeight="48dp"
        android:id="@+id/input_recent_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="@string/recent_search_hint"
        android:importantForAutofill="no"
        android:inputType="textUri"
        android:maxLines="1"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/recent_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxHeight="180dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/recent_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/clear_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/clear_history"
        android:textColor="@color/status_off"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/advanced_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingVertical="8dp"
        android:text="@string/advanced_options"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/text_secondary"
        android:background="?android:attr/selectableItemBackground" />

    <LinearLayout
        android:id="@+id/advanced_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minHeight="48dp"
            android:id="@+id/input_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/name_hint_optional"
            android:inputType="text"
            android:autofillHints="name" />

        <EditText
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minHeight="48dp"
            android:id="@+id/input_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/username_hint_optional"
            android:inputType="text"
            android:autofillHints="username" />

        <EditText
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minHeight="48dp"
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/password_hint_optional"
            android:inputType="textPassword"
            android:autofillHints="password" />

        <EditText
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minHeight="48dp"
            android:id="@+id/input_headers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/headers_hint_optional"
            android:inputType="textMultiLine"
            android:importantForAutofill="no"
            android:minLines="2"
            android:maxLines="4" />

        <EditText
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minHeight="48dp"
            android:id="@+id/input_checksum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/checksum_hint_optional"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minHeight="48dp"
            android:id="@+id/input_mirrors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/mirrors_hint_optional"
            android:importantForAutofill="no"
            android:inputType="textUri|textMultiLine"
            android:minLines="2"
            android:maxLines="4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/speed_limit_per_label"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Spinner
            android:id="@+id/spinner_speed_limit_per"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/priority_label"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Spinner
            android:id="@+id/spinner_priority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
