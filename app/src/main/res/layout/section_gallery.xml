<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section_gallery"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_status_card"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/header_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="-14dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        app:drawableEndCompat="@drawable/ic_chevron"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="14dp"
        android:text="@string/settings_section_gallery"
        android:textColor="@color/primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_gallery_image_label"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <EditText
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:minHeight="48dp"
        android:id="@+id/input_gallery_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_tv"
        android:hint="@string/settings_gallery_folder_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/settings_gallery_video_label"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <EditText
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:minHeight="48dp"
        android:id="@+id/input_gallery_video"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_tv"
        android:hint="@string/settings_gallery_folder_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="2" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/settings_gallery_hint"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?android:attr/textColorSecondary" />
</LinearLayout>
