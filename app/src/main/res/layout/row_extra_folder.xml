<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="horizontal">

    <EditText
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:minHeight="48dp"
        android:id="@+id/extra_folder_path"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_input_tv"
        android:hint="@string/storage_extra_folder_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1" />

    <Button
        android:id="@+id/btn_remove_folder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_gravity="center_vertical"
        android:stateListAnimator="@null"
        android:background="@drawable/bg_btn_tv"
        android:backgroundTint="@null"
        android:minHeight="40dp"
        android:text="@string/storage_remove_folder"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp" />
</LinearLayout>
