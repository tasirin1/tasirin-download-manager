<?xml version="1.0" encoding="utf-8"?>
<!-- Petak ikon berkas apk: gradasi diagonal di kartu unduhan. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/tile_apk_end"
        android:startColor="@color/tile_apk_start"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
