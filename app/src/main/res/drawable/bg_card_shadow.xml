<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bayangan lembut di bawah card -->
    <item
        android:left="0dp"
        android:top="3dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A10141C" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Badan card -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
