<?xml version="1.0" encoding="utf-8"?>
<!-- Background item download: efek timbul (kartu) di semua state,
     dengan overlay fokus/pressed agar tetap terlihat interaktif. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="#33000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <solid android:color="#55FF6F00" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="#33000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <solid android:color="#440D47A1" />
                    <stroke android:width="2dp" android:color="@color/primary" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <solid android:color="#26000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <solid android:color="@color/card_bg" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
