<?xml version="1.0" encoding="utf-8"?>
<!-- Empty state icon: gradien biru lembut + ring putih tipis (lebih timbul). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bayangan bawah -->
    <item android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#1A10141C" />
        </shape>
    </item>
    <!-- Badan gradien -->
    <item android:bottom="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#EAF2FD"
                android:endColor="#D6E7FA" />
            <stroke android:width="2dp" android:color="@color/white" />
        </shape>
    </item>
</layer-list>
