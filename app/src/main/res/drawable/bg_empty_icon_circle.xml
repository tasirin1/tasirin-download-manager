<?xml version="1.0" encoding="utf-8"?>
<!-- Empty state icon: blok tonal primary_container flat + ring putih,
     bayangan tipis rendah-opasitas (elevasi lembut, tak berat). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bayangan bawah: offset kecil + ~5% opasitas -->
    <item android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="#0D10141C" />
        </shape>
    </item>
    <!-- Badan tonal flat -->
    <item android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/primary_container" />
            <stroke android:width="2dp" android:color="@color/white" />
        </shape>
    </item>
</layer-list>
