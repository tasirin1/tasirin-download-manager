<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol sekunder tema terang: putih + garis tepi halus;
     fokus D-pad = ring aksen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_glass_fill" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_alpha_10" />
            <stroke android:width="1dp" android:color="@color/home_glass_stroke" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_glass_fill" />
            <stroke android:width="1dp" android:color="@color/home_glass_stroke" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
