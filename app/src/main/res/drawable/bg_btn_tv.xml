<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol tonal gaya M3: terisi primary_container + teks primary (di style),
     tanpa outline. Fokus D-pad tetap tegas via stroke 2dp. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <stroke android:width="2dp" android:color="@color/primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container_pressed" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
