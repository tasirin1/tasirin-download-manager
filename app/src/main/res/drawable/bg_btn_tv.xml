<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol tonal gaya M3: terisi primary_container + teks primary (di style).
     Stroke 1dp primary di state normal/pressed agar tak menyatu dengan kartu
     putih; fokus D-pad selalu aksen oranye 3dp (ala vault) agar tak tertukar
     dengan biru primer saat navigasi remote TV.
     Keadaan nonaktif (issue #1537): item state_enabled=false di semua
     selector tombol resmi berisi abu @color/line teredam + teks gaya
     teredam via res/color/btn_text_*; tanpa item itu tombol mati tampil
     persis seperti tombol hidup. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/line" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container_pressed" />
            <stroke android:width="1dp" android:color="@color/primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <stroke android:width="1dp" android:color="@color/primary" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
