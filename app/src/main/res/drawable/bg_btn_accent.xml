<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol aksen: ring oranye tua 3dp saat fokus D-pad — tetap keluarga
     oranye (ala vault: fokus selalu oranye) tapi kontras di atas isi aksen;
     jangan biru tua agar tak salah pilih. Isi lebih gelap saat ditekan. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <stroke android:width="3dp" android:color="#8A3D00" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D86A00" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
