<?xml version="1.0" encoding="utf-8"?>
<!-- Kolom input: fokus/tekan D-pad selalu aksen oranye 3dp (ala vault),
     bukan biru primer agar tak salah pilih di TV. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F4F6FA" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
