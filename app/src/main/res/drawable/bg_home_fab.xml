<?xml version="1.0" encoding="utf-8"?>
<!-- FAB Add tema terang: gradasi biru Vaultwarden; fokus D-pad = ring aksen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#42A5F5" android:centerColor="#1565C0" android:endColor="#0D47A1" android:type="linear" />
            <stroke android:width="3dp" android:color="@color/accent" /><corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#1E88E5" android:centerColor="#0D47A1" android:endColor="#08306B" android:type="linear" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#42A5F5" android:centerColor="#1565C0" android:endColor="#0D47A1" android:type="linear" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
