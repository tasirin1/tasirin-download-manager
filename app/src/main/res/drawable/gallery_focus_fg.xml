<?xml version="1.0" encoding="utf-8"?>
<!-- Indikator fokus sel galeri (issue #1535): item galeri focusable tetapi
     tak punya drawable keadaan apa pun, jadi navigasi D-pad di Android 6
     buta total. Dipasang sebagai FOREGROUND akar sel agar tata letak dan
     thumbnail tak bergeser/tertutup latar baru: bawaan transparan, fokus =
     cucian aksen tipis + ring aksen 3dp mengelilingi sel (pola visual yang
     sama dengan fokus kartu unduhan). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33F57C00" />
            <stroke android:width="3dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
