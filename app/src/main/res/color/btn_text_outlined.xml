<?xml version="1.0" encoding="utf-8"?>
<!-- Warna teks tombol outline (TvOutlinedButton):
     - nonaktif teredam ke text_hint agar tombol mati terbaca mati
       (issue #1537);
     - ditekan memakai primary_dark: teks primer di atas isian pressed
       primary_container_pressed hanya 3,99:1 (di bawah AA 4,5:1),
       sedangkan primary_dark di atasnya 5,99:1 (issue #1538) — teks
       yang menggelap saat ditekan juga memperkuat beda visual pressed;
     - keadaan lain tetap primer seperti sebelumnya. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_hint" />
    <item android:state_pressed="true" android:color="@color/primary_dark" />
    <item android:color="@color/primary" />
</selector>
